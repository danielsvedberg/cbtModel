+def get_bg_gain(params_nm, all_zs, noise=True):
+    """
+    Reconstruct the SPN gains of test_model trials from SNc states: the rank-2 DA gains G_d1 = exp(+s_d1) and
+    G_d2 = exp(-s_d2), with s = da_signals(m, c, x_nm). multiregion_nmrnn does not return them; this replays its
+    noise draws (same keys as test_model), so it matches the simulation exactly. all_zs: (n_seeds, n_conditions, T, n_nm).
+    Returns G_d1, G_d2, pop_gain_d1, pop_gain_d2, each (n_seeds, n_conditions, T); the excitability traces were removed
+    from the model, so the pop gains are ones (kept for plot_binned_responses' four-panel layout).
+    """
+    n = cs.test_noise_std if noise else 0
+    tau_z = cs.config['tau_z']
+    m, c = params_nm['m'], params_nm['c']
+
+    def _single(zs, rng_key):  # zs: T x n_nm
+        _, init_key, step_key = jr.split(rng_key, 3)
+        x_nm0 = cs.z0 + n * jr.normal(init_key, cs.z0.shape) if n > 0 else cs.z0
+        step_keys = jr.split(step_key, zs.shape[0])
+        x_prev = jnp.concatenate((x_nm0[None], zs[:-1]))  # x_nm entering each step
+        if n > 0:
+            x_prev = x_prev + n / math.sqrt(2 * tau_z) * vmap(lambda k: jr.normal(k, cs.z0.shape))(step_keys)
+        s = vmap(lambda x: da_signals(m, c, x))(x_prev)  # T x 2
+        ones = jnp.ones(s.shape[0])
+        return jnp.exp(s[:, 0]), jnp.exp(-s[:, 1]), ones, ones
+
+    out = []
+    for seed in range(all_zs.shape[0]):
+        keys = jr.split(jr.PRNGKey(seed), all_zs.shape[1])
+        out.append(vmap(_single)(all_zs[seed], keys))
+    return tuple(jnp.stack(g) for g in zip(*out))
+
+
